ometry x="676.0" y="981.0" width="118" height="58" as="geometry"/></mxCell><mxCell id="er1-e71" value="(1,1)" style="fontFamily=Helvetica;endArrow=none;html=1;strokeColor=#455A64;strokeWidth=1.3;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#BF360C;" edge="1" parent="1" source="er1-v19" target="er1-v70"><mxGeometry x="-0.55" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="er1-e72" value="(0,N)" style="fontFamily=Helvetica;endArrow=none;html=1;strokeColor=#455A64;strokeWidth=1.3;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#BF360C;" edge="1" parent="1" source="er1-v17" target="er1-v70"><mxGeometry x="-0.55" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="er1-v73" value="PICTURED BY" style="fontFamily=Helvetica;shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F57F17;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="151.0" y="1191.0" width="118" height="58" as="geometry"/></mxCell><mxCell id="er1-e74" value="(0,N)" style="fontFamily=Helvetica;endArrow=none;html=1;strokeColor=#455A64;strokeWidth=1.3;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#BF360C;" edge="1" parent="1" source="er1-v19" target="er1-v73"><mxGeometry x="-0.55" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="er1-e75" value="(1,1)" style="fontFamily=Helvetica;endArrow=none;html=1;strokeColor=#455A64;strokeWidth=1.3;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#BF360C;" edge="1" parent="1" source="er1-v21" target="er1-v73"><mxGeometry x="-0.55" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="er1-v76" value="CHANGED BY" style="fontFamily=Helvetica;shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F57F17;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="501.0" y="1241.0" width="118" height="58" as="geometry"/></mxCell><mxCell id="er1-e77" value="(1,N)*" style="fontFamily=Helvetica;endArrow=none;html=1;strokeColor=#455A64;strokeWidth=1.3;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#BF360C;" edge="1" parent="1" source="er1-v19" target="er1-v76"><mxGeometry x="-0.55" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="er1-e78" value="(1,1)" style="fontFamily=Helvetica;endArrow=none;html=1;strokeColor=#455A64;strokeWidth=1.3;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#BF360C;" edge="1" parent="1" source="er1-v23" target="er1-v76"><mxGeometry x="-0.55" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="er1-v79" value="SUPPLIES" style="fontFamily=Helvetica;shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F57F17;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="798.0" y="1141.0" width="124" height="58" as="geometry"/></mxCell><mxCell id="er1-e80" value="(0,N)" style="fontFamily=Helvetica;endArrow=none;html=1;strokeColor=#455A64;strokeWidth=1.3;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#BF360C;" edge="1" parent="1" source="er1-v19" target="er1-v79"><mxGeometry x="-0.55" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="er1-e81" value="(1,1)" style="fontFamily=Helvetica;endArrow=none;html=1;strokeColor=#455A64;strokeWidth=1.3;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#BF360C;" edge="1" parent="1" source="er1-v25" target="er1-v79"><mxGeometry x="-0.55" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="er1-v82" value="FULFILLED BY" style="fontFamily=Helvetica;shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F57F17;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1398.0" y="971.0" width="124" height="58" as="geometry"/></mxCell><mxCell id="er1-e83" value="(0,N)" style="fontFamily=Helvetica;endArrow=none;html=1;strokeColor=#455A64;strokeWidth=1.3;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#BF360C;" edge="1" parent="1" source="er1-v13" target="er1-v82"><mxGeometry x="-0.55" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="er1-e84" value="(1,1)" style="fontFamily=Helvetica;endArrow=none;html=1;strokeColor=#455A64;strokeWidth=1.3;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#BF360C;" edge="1" parent="1" source="er1-v25" target="er1-v82"><mxGeometry x="-0.55" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="er1-v85" value="CONFIRMED BY" style="fontFamily=Helvetica;shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F57F17;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1443.0" y="1221.0" width="124" height="58" as="geometry"/></mxCell><mxCell id="er1-e86" value="(0,1)" style="fontFamily=Helvetica;endArrow=none;html=1;strokeColor=#455A64;strokeWidth=1.3;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#BF360C;" edge="1" parent="1" source="er1-v25" target="er1-v85"><mxGeometry x="-0.55" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="er1-e87" value="(1,1)" style="fontFamily=Helvetica;endArrow=none;html=1;strokeColor=#455A64;strokeWidth=1.3;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#BF360C;" edge="1" parent="1" source="er1-v27" target="er1-v85"><mxGeometry x="-0.55" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="er1-v88" value="CAUSES" style="fontFamily=Helvetica;shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F57F17;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="928.0" y="1401.0" width="124" height="58" as="geometry"/></mxCell><mxCell id="er1-e89" value="(1,N)*" style="fontFamily=Helvetica;endArrow=none;html=1;strokeColor=#455A64;strokeWidth=1.3;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#BF360C;" edge="1" parent="1" source="er1-v25" target="er1-v88"><mxGeometry x="-0.55" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="er1-e90" value="(0,1)" style="fontFamily=Helvetica;endArrow=none;html=1;strokeColor=#455A64;strokeWidth=1.3;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#BF360C;" edge="1" parent="1" source="er1-v23" target="er1-v88"><mxGeometry x="-0.55" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="er1-v91" value='&lt;b style="font-size:20px"&gt;Farm-to-Market — Conceptual ER diagram&lt;/b&gt;&lt;br&gt;COSC444 Database Systems · Khalifa University · Lab B1 · Chen notation with (min,max) participation' style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="780" height="60" as="geometry"/></mxCell><mxCell id="er1-v92" value="&lt;b&gt;How to read&lt;/b&gt;&lt;br&gt;Rectangle = entity; diamond = relationship; ellipse = relationship attribute.&lt;br&gt;&lt;b&gt;(min,max)&lt;/b&gt; beside an entity = how many times one instance of that entity takes part in the relationship. Example: FARM (1,1) LOCATED IN EMIRATE (0,N) — every farm is in exactly one emirate; an emirate may have none or many farms.&lt;br&gt;&lt;u&gt;underlined&lt;/u&gt; = identifier; &lt;font color=&quot;#6A1B9A&quot;&gt;&lt;i&gt;/name&lt;/i&gt;&lt;/font&gt; = derived (computed, not entered).&lt;br&gt;&lt;b&gt;*&lt;/b&gt; minimum guaranteed by the application, not by SQL: every lot gets a HARVEST_ADDED movement, every allocation a RESERVED movement and every request a 'Request created' status row in the same transaction." style="fontFamily=Helvetica;rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2020" y="40" width="440" height="150" as="geometry"/></mxCell><mxCell id="er1-v93" value="&lt;b&gt;Key business rules shown by the model&lt;/b&gt;&lt;br&gt;&lt;b&gt;R1&lt;/b&gt; A farm runs many crop cycles; each lot comes from exactly one cycle, so a lot's crop and farm are derived through its cycle (BR-01).&lt;br&gt;&lt;b&gt;R2&lt;/b&gt; expected_quantity is a &lt;i&gt;forecast&lt;/i&gt; on CROP_CYCLE. Stock exists only on HARVEST_LOT and is never mixed with the forecast (BR-02).&lt;br&gt;&lt;b&gt;R3&lt;/b&gt; /on_hand, /reserved, /available are &lt;i&gt;derived&lt;/i&gt; from the dated STOCK_MOVEMENT ledger, never stored (BR-03).&lt;br&gt;&lt;b&gt;R4&lt;/b&gt; ALLOCATION links one request to one lot. A request can be split across many lots (partial fulfilment) and a lot can supply many requests. An allocation can never exceed the lot's available quantity (BR-04, application-enforced under a lot row lock).&lt;br&gt;&lt;b&gt;R5&lt;/b&gt; At most one DELIVERY_RECEIPT per allocation (UNIQUE). It records the received quantity; the shortfall is stored as the discrepancy, released from the reservation and recorded as LOSS (BR-05).&lt;br&gt;&lt;b&gt;R6&lt;/b&gt; Every quantity is in an explicit UNIT. Allocations, receipts and movements carry the lot's unit; equality with the lot/request unit is application-enforced. There is no conversion (BR-06).&lt;br&gt;&lt;b&gt;R7&lt;/b&gt; Only farmers are ASSIGNED TO farms; only market buyers BUY FOR exactly one market (SQL CHECK chk_user_market). Administrators have neither link (BR-07).&lt;br&gt;&lt;b&gt;R8&lt;/b&gt; Each STOCK_MOVEMENT, REQUEST_STATUS_CHANGE, CROP_CYCLE, HARVEST_LOT, LOT_IMAGE, MARKET_REQUEST, ALLOCATION and DELIVERY_RECEIPT records exactly one responsible USER: USER (0,N) — record (1,1). These eight accountability links are drawn on relational schema page 5 (BR-08).&lt;br&gt;&lt;b&gt;R9&lt;/b&gt; Every LOT_IMAGE belongs to exactly one lot and stores JPEG/PNG bytes (BLOB) (BR-09).&lt;br&gt;&lt;b&gt;R10&lt;/b&gt; Reference entities and users are deactivated (is_active), not deleted, so history is kept." style="fontFamily=Helvetica;rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFFFFF;strokeColor=#2E7D32;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2020" y="900" width="440" height="470" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
