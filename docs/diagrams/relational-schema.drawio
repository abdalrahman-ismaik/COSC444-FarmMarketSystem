strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#37474F;" edge="1" parent="1" source="rs2-v171" target="rs2-v46"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1016" y="785"/><mxPoint x="1016" y="500"/></Array></mxGeometry></mxCell><mxCell id="rs2-e196" value="user_id" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;endSize=12;startSize=12;strokeColor=#616161;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#37474F;" edge="1" parent="1" source="rs2-v171" target="rs2-v133"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rs2-v197" value="&lt;b&gt;Notation&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; primary key (underlined) · &lt;b&gt;FK&lt;/b&gt; foreign key (italic) · &lt;b&gt;UQ&lt;/b&gt; UNIQUE&lt;br&gt;Crow's foot at the FK (child) table: &lt;i&gt;zero-or-many&lt;/i&gt;, or &lt;i&gt;zero-or-one&lt;/i&gt; when the FK is UNIQUE.&lt;br&gt;Double bar at the referenced (parent) table: &lt;i&gt;exactly one&lt;/i&gt; when the FK is NOT NULL; circle+bar: &lt;i&gt;zero-or-one&lt;/i&gt; when the FK is nullable.&lt;br&gt;No ON DELETE/ON UPDATE actions are declared (MySQL default: RESTRICT/NO ACTION). No engine is named in the DDL (MySQL 8 default: InnoDB); charset utf8mb4.&lt;br&gt;Source of truth: &lt;b&gt;app/schema.sql&lt;/b&gt;. Cross-row rules (unit equality, stock ≥ 0, farmer-only assignment) are enforced in app/db.py, not by SQL." style="fontFamily=Helvetica;rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="916" height="165" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="rs3" name="3 Production, lots, images, stock ledger"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="rs3-v1" value="&lt;b&gt;Relational schema — page 3: crop cycles (forecast), harvest lots (stock), BLOB images and the stock-movement ledger.&lt;/b&gt; Grey dashed boxes are tables detailed on other pages. FKs to units/users are labelled in the rows and drawn on page 5." style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1900" height="40" as="geometry"/></mxCell><mxCell id="rs3-v2" value="crop_cycles" style="fontFamily=Helvetica;shape=table;startSize=30;container=1;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=1;align=center;resizeLast=1;html=1;fontSize=13;fillColor=#E8F5E9;strokeColor=#2E7D32;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="916" height="250" as="geometry"/></mxCell><mxCell id="rs3-v3" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;html=1;" vertex="1" parent="rs3-v2"><mxGeometry x="0" y="30" width="916" height="22" as="geometry"/></mxCell><mxCell id="rs3-v4" value="PK" style="fontFamily=Helvetica;shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=nowrap;html=1;fontSize=12;align=left;spacingLeft=6;fontStyle=1;fontColor=#1B5E20;" vertex="1" parent="rs3-v3"><mxGeometry x="0" y="0" width="52" height="22" as="geometry"/></mxCell><mxCell id="rs3-v5" value="cycle_id" style="fontFamily=Helvetica;shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=nowrap;html=1;fontSize=12;align=left;spacingLeft=6;fontStyle=5;" vertex="1" parent="rs3-v3"><mxGeometry x="52" y="0" width="170" height="22" as="geometry"/></mxCell><mxCell id=