"1" parent="rs5-v98"><mxGeometry x="52" y="0" width="230" height="22" as="geometry"/></mxCell><mxCell id="rs5-e101" value="unit_id" style="fontFamily=Helvetica;rounded=0;html=1;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;endSize=12;startSize=12;strokeColor=#1565C0;strokeWidth=1.2;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#37474F;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="rs5-v94" target="rs5-v2"><mxGeometry x="-0.45" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rs5-e102" value="user_id" style="fontFamily=Helvetica;rounded=0;html=1;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;endSize=12;startSize=12;strokeColor=#6D4C41;strokeWidth=1.2;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#37474F;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="rs5-v94" target="rs5-v15"><mxGeometry x="-0.45" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rs5-v103" value='&lt;font color="#1565C0"&gt;&lt;b&gt;Blue&lt;/b&gt;&lt;/font&gt;: 7 FKs → units.unit_id (all NOT NULL). &lt;font color="#6D4C41"&gt;&lt;b&gt;Brown&lt;/b&gt;&lt;/font&gt;: 8 FKs → users.user_id (all NOT NULL; responsible user). Unit equality between a lot and its allocations, receipts and movements, and with the request it supplies, is checked in app/db.py; SQL only checks that each unit exists.' style="fontFamily=Helvetica;rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFFFFF;strokeColor=#BDBDBD;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="640" width="420" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="rs6" name="6 Derived views (not stored)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="rs6-v1" value="&lt;b&gt;Relational schema — page 6: the two SQL views.&lt;/b&gt; Views store no rows; they are recomputed from base tables on every query. The GUI and the read-only assistant read them." style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1200" height="40" as="geometry"/></mxCell><mxCell id="rs6-v2" value="&lt;b&gt;VIEW v_lot_stock&lt;/b&gt; — one row per harvest lot&lt;br&gt;&lt;br&gt;&lt;b&gt;Columns:&lt;/b&gt; lot_id, cycle_id, farm_id, farm_name, emirate_name, crop_id, crop_name, unit_id, unit_code, quantity_harvested, harvest_date, sell_by_date, is_active, &lt;i&gt;on_hand&lt;/i&gt;, &lt;i&gt;reserved&lt;/i&gt;, &lt;i&gt;available&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Reads:&lt;/b&gt; harvest_lots ⋈ crop_cycles ⋈ farms ⋈ emirates ⋈ crops ⋈ units, LEFT JOIN stock_movements, GROUP BY lot&lt;br&gt;&lt;br&gt;&lt;b&gt;on_hand&lt;/b&gt; = Σ HARVEST_ADDED + Σ CORRECTION (signed) − Σ DELIVERED − Σ LOSS − Σ DONATED − Σ DISPOSED&lt;br&gt;&lt;b&gt;reserved&lt;/b&gt; = Σ RESERVED − Σ RESERVATION_RELEASED − Σ DELIVERED&lt;br&gt;&lt;b&gt;available&lt;/b&gt; = on_hand − reserved&lt;br&gt;&lt;br&gt;Unit = the lot's unit (units are never mixed). A lot with no movements shows 0/0/0. Expected harvest (crop_cycles.expected_quantity) is &lt;u&gt;not&lt;/u&gt; an input: forecast stays separate from stock." style="fontFamily=Helvetica;rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#F3E5F5;strokeColor=#6A1B9A;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="620" height="300" as="geometry"/></mxCell><mxCell id="rs6-v3" value="&lt;b&gt;VIEW v_request_status&lt;/b&gt; — one row per market request&lt;br&gt;&lt;br&gt;&lt;b&gt;Columns:&lt;/b&gt; request_id, market_id, market_name, emirate_name, crop_id, crop_name, requested_quantity, unit_code, needed_by_date, status, created_at, &lt;i&gt;allocated_quantity&lt;/i&gt;, &lt;i&gt;received_quantity&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Reads:&lt;/b&gt; market_requests ⋈ markets ⋈ emirates ⋈ crops ⋈ units, with correlated sub-queries on allocations and delivery_receipts&lt;br&gt;&lt;br&gt;&lt;b&gt;allocated_quantity&lt;/b&gt; = Σ allocations.allocated_quantity WHERE status ≠ 'RELEASED' (includes already-delivered allocations)&lt;br&gt;&lt;b&gt;received_quantity&lt;/b&gt; = Σ delivery_receipts.received_quantity over the request's allocations&lt;br&gt;&lt;br&gt;&lt;b&gt;status&lt;/b&gt; is the stored market_requests.status, maintained by app/db.py (_refresh_request_status); the view does not recompute it." style="fontFamily=Helvetica;rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#F3E5F5;strokeColor=#6A1B9A;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="70" width="620" height="300" as="geometry"/></mxCell><mxCell id="rs6-v4" value="&lt;b&gt;stock_movements&lt;/b&gt;&lt;br&gt;+ harvest_lots, crop_cycles, farms, emirates, crops, units" style="fontFamily=Helvetica;rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="620" height="60" as="geometry"/></mxCell><mxCell id="rs6-v5" value="&lt;b&gt;allocations, delivery_receipts&lt;/b&gt;&lt;br&gt;+ market_requests, markets, emirates, crops, units" style="fontFamily=Helvetica;rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="700" y="430" width="620" height="60" as="geometry"/></mxCell><mxCell id="rs6-e6" value="computed from" style="fontFamily=Helvetica;endArrow=block;endFill=1;dashed=1;html=1;strokeColor=#6A1B9A;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="rs6-v4" target="rs6-v2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rs6-e7" value="computed from" style="fontFamily=Helvetica;endArrow=block;endFill=1;dashed=1;html=1;strokeColor=#6A1B9A;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="rs6-v5" target="rs6-v3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
